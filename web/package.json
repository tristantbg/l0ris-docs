{
	"name": "svelte-docs-starter",
	"version": "1.0.0",
	"description": "A modern, full-featured documentation starter built with SvelteKit, Tailwind CSS v4, shadcn-svelte, and MDSvex.",
	"author": "code-gio",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/code-gio/svelte-docs-starter"
	},
	"homepage": "https://github.com/code-gio/svelte-docs-starter",
	"bugs": {
		"url": "https://github.com/code-gio/svelte-docs-starter/issues"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"documentation",
		"docs",
		"starter",
		"template",
		"tailwindcss",
		"shadcn-svelte",
		"mdsvex",
		"markdown"
	],
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "pagefind --site build --output-path build/pagefind",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "eslint . && prettier --check .",
		"clean": "node scripts/clean.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.31.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@unlazy/svelte": "^2.0.1",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.8.1",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"mode-watcher": "^1.1.0",
		"pagefind": "^1.4.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"svelte-eslint-parser": "^1.8.0",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.1"
	},
	"dependencies": {
		"@netlify/functions": "^5.3.0",
		"@portabletext/svelte": "^3.0.1",
		"@portabletext/types": "^4.0.2",
		"@sanity/client": "^7.26.2",
		"@sanity/image-url": "^2.1.1",
		"@sanity/webhook": "^4.0.4",
		"@shikijs/transformers": "^4.4.2",
		"shiki": "^4.4.2",
		"unlazy": "^2.0.1"
	}
}
