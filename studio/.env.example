# ──────────────────────────────────────────────
# Sanity Studio Configuration
# ──────────────────────────────────────────────

# Display name shown in the Studio UI
SANITY_STUDIO_PROJECT_TITLE=""

# Unique project identifier from sanity.io/manage
SANITY_STUDIO_PROJECT_ID=""

# Dataset to read/write content from
SANITY_STUDIO_DATASET="production"

# Sanity API version (date) used by all clients and structure lists
SANITY_STUDIO_API_VERSION="2025-02-19"

# Custom Studio hostname (<name>.sanity.studio)
SANITY_STUDIO_HOST=""

# Video provider
SANITY_STUDIO_VIDEO_PROVIDER="mux|vimeo"

# ──────────────────────────────────────────────
# Preview & Front-end
# ──────────────────────────────────────────────

# Base URL used for live preview links in the Studio
SANITY_STUDIO_PREVIEW_ORIGIN=""

# Production URL for "View on Site" action
SANITY_STUDIO_PRODUCTION_URL=""

# ──────────────────────────────────────────────
# Deployment
# ──────────────────────────────────────────────

# App ID returned by `sanity deploy` (set automatically by setup script)
SANITY_STUDIO_APP_ID=""